    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@mneme/core": "workspace:*",
    "@mneme/store": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
