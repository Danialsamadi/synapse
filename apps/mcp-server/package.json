{
  "name": "synapse-mcp",
  "version": "0.2.0",
  "description": "Synapse — local-first long-term memory for AI agents, over MCP",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danialsamadi/synapse.git",
    "directory": "apps/mcp-server"
  },
  "keywords": ["mcp", "memory", "ai-agents", "sqlite", "local-first"],
  "bin": {
    "synapse-mcp": "dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "start": "node preflight.mjs && tsx src/index.ts",
    "build": "tsup",
    "prepack": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^12.11.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@synapse/core": "workspace:*",
    "@synapse/store": "workspace:*",
    "@synapse/embeddings": "workspace:*",
    "@synapse/sdk": "workspace:*",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
