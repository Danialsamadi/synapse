{
  "name": "synapse",
  "private": true,
  "version": "0.1.0",
  "description": "Synapse \u2014 Personal AI Memory OS",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @synapse/api dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "eval": "pnpm --filter @synapse/evals test",
    "cli": "pnpm --filter @synapse/cli start",
    "mcp": "pnpm --filter @synapse/mcp-server start"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Danialsamadi/synapse.git"
  }
}
