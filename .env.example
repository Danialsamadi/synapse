# Synapse remote MCP for Railway
NODE_ENV=production
PORT=8787
SYNAPSE_HOST=0.0.0.0
SYNAPSE_DB=/data/synapse.db
# JSON object whose opaque keys are bearer tokens; never commit real values.
# Example shape: {"TOKEN_A":{"userId":"user_a","teamIds":["team_1"]}}
SYNAPSE_TOKENS_JSON=
SYNAPSE_EMBED_PROVIDER=hash
SYNAPSE_EMBED_BASE_URL=https://api.openai.com/v1
SYNAPSE_EMBED_API_KEY=
SYNAPSE_EMBED_MODEL=text-embedding-3-small
SYNAPSE_EMBED_DIMENSIONS=1536
SYNAPSE_LLM_BASE_URL=https://api.openai.com/v1
SYNAPSE_LLM_API_KEY=
SYNAPSE_LLM_MODEL=gpt-4o-mini
SYNAPSE_LLM_TEMPERATURE=0
