# Synapse — Personal AI Memory OS
# Copy to .env and fill in values.

# ── Database ──────────────────────────────────────
SYNAPSE_DB=.synapse/synapse.db

# ── API Server ────────────────────────────────────
PORT=8787
SYNAPSE_TOKEN=          # Bearer token for API auth (optional)

# ── Embeddings ────────────────────────────────────
SYNAPSE_EMBED_PROVIDER=hash        # "hash" (test/offline) or "openai"
SYNAPSE_EMBED_BASE_URL=https://api.openai.com/v1
SYNAPSE_EMBED_API_KEY=
SYNAPSE_EMBED_MODEL=text-embedding-3-small
SYNAPSE_EMBED_DIMENSIONS=1536

# ── LLM (consolidation & conflict detection) ─────
SYNAPSE_LLM_BASE_URL=https://api.openai.com/v1
SYNAPSE_LLM_API_KEY=
SYNAPSE_LLM_MODEL=gpt-4o-mini
SYNAPSE_LLM_TEMPERATURE=0

# ── Demo Agent ────────────────────────────────────
SYNAPSE_URL=http://localhost:8787
