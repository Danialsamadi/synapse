# Mneme — Personal AI Memory OS
# Copy to .env and fill in values.

# ── Database ──────────────────────────────────────
MNEME_DB=.mneme/mneme.db

# ── API Server ────────────────────────────────────
PORT=8787
MNEME_TOKEN=          # Bearer token for API auth (optional)

# ── Embeddings ────────────────────────────────────
MNEME_EMBED_PROVIDER=hash        # "hash" (test/offline) or "openai"
MNEME_EMBED_BASE_URL=https://api.openai.com/v1
MNEME_EMBED_API_KEY=
MNEME_EMBED_MODEL=text-embedding-3-small
MNEME_EMBED_DIMENSIONS=1536

# ── LLM (consolidation & conflict detection) ─────
MNEME_LLM_BASE_URL=https://api.openai.com/v1
MNEME_LLM_API_KEY=
MNEME_LLM_MODEL=gpt-4o-mini
MNEME_LLM_TEMPERATURE=0

# ── Demo Agent ────────────────────────────────────
MNEME_URL=http://localhost:8787
